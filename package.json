{
  "name": "dsh-nasapunk-theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A light NASA-punk theme: warm paper surfaces, ink hairlines, stamp-red accent.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "docs", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-theme", "@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
